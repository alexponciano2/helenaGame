* text=auto

# Unity YAML assets should remain text and use stable line endings.
*.meta text eol=lf
*.unity text eol=lf
*.prefab text eol=lf
*.asset text eol=lf
*.mat text eol=lf
*.anim text eol=lf
*.controller text eol=lf
*.overrideController text eol=lf
*.playable text eol=lf
*.mask text eol=lf

# Source and project configuration.
*.cs text eol=lf
*.asmdef text eol=lf
*.asmref text eol=lf
*.json text eol=lf
*.md text eol=lf
*.toml text eol=lf

# Binary assets.
*.png binary
*.jpg binary
*.jpeg binary
*.psd binary
*.tga binary
*.gif binary
*.wav binary
*.mp3 binary
*.ogg binary
*.fbx binary
*.blend binary
*.ttf binary
*.otf binary
